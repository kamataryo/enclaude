#!/bin/sh
set -eu

# シンボリックリンク経由で呼ばれてもリポジトリを見つける
src="$0"
while [ -L "$src" ]; do
  src="$(cd "$(dirname "$src")" && pwd)/$(readlink "$src")"
done
repo="$(cd "$(dirname "$src")/.." && pwd)"

compose() { docker compose -f "$repo/compose.yml" "$@"; }

# Dockerfile.override があれば、ベースを enclaude-base として焼いてから皮をかぶせる。
# compose 側は dockerfile: ${ENCLAUDE_DOCKERFILE:-Dockerfile} で受ける
overlay() {
  [ -e "$repo/Dockerfile.override" ] || return 0
  if [ "${1:-}" = quiet ]; then
    docker build -q -t enclaude-base "$repo" >/dev/null
  else
    docker build -t enclaude-base "$repo"
  fi
  export ENCLAUDE_DOCKERFILE=Dockerfile.override
}

# 一覧の表示上限。打ち切ったことは必ず言う（後述）
max=200

# 走査の対象。.git/ は git status を叩くだけでも index が動くのでノイズになるが、
# hooks と config だけは例外で見る。これらは ro マウントで書き込みを止めているものの、
# .git がファイルになる worktree / submodule ではそのガードが効かない。
# そこを検知でも拾わないと、予防も検知も無い状態になってしまう。
# submodule のフックは .git/modules/<name>/hooks/ にあるので、深さを固定せず拾う
scan_files() {
  # symlink も対象にする（既存ファイルをリンクに差し替える手が -type f では見えない）。
  # *.sample は git が実行しないので数だけ増えてノイズになる
  find . \( -type f -o -type l \) \
    \( -not -path './.git/*' \
       -o \( -path '*/hooks/*' ! -name '*.sample' \) \
       -o -name config -o -name config.worktree \) "$@"
}

# 削除の検出用。開始時と終了時で同じ並びにしたいので照合順序を固定する
snapshot_files() { scan_files | LC_ALL=C sort; }

# 打ち切った件数を必ず添える。黙って切ると、ゴミを大量に書いて本命を一覧の外へ
# 押し出す隠蔽が成立してしまう
omitted() {
  n="$(echo "$1" | wc -l)"
  [ "$n" -le "$max" ] || echo "  （ほか $((n - max)) 件を省略）"
}

# セッションの基準時刻とファイル一覧の控えは、終了後に enclaudé diff から読み直したいので
# ワークスペースごとに残す（mktemp だと消えるうえ、パスから引き直せない）
state_stamp() {
  d="${XDG_STATE_HOME:-$HOME/.local/state}/enclaude"
  mkdir -p "$d"
  echo "$d/$(echo "$1" | sed 's|/|%|g')"
}

# コンテナが書き換えたファイルを、git の --stat 形式で見せる。
# git status では見えない gitignore 済み・untracked のファイルこそ見たいので、
# 対象は自前で集め、一時 index に intent-to-add してから diff を取る
# （ホストの index は触らない）
report_changes() {
  ws="$1"; stamp="$2"; mode="${3:-run}"
  # 検出は mtime ではなく ctime で行う。mtime は touch -r で戻せるが、ctime を任意の値に
  # する手段はユーザー空間に無いので隠蔽できない。chmod だけの変更もこれで拾える
  changed="$(cd "$ws" && scan_files -cnewer "$stamp")"
  # .git/ 配下は worktree の外なので git diff の pathspec に渡せない。分けて出す。
  # ホストの git が直接実行するものなので、stat の 1 行に埋もれるより目立つ方がよい
  ingit="$(echo "$changed" | grep '^\./\.git/' || :)"
  files="$(echo "$changed" | grep -v '^\./\.git/' || :)"
  # 削除は ctime では拾えないので、開始時の一覧との差で出す
  gone="$(cd "$ws" && snapshot_files | comm -23 "$stamp.before" -)"
  [ -n "$files$ingit$gone" ] || { [ "$mode" = run ] || echo "変更はありません"; return 0; }
  echo
  if [ -n "$files" ]; then
    echo "コンテナ内で書き換えられたファイル:"
    if idx="$(cd "$ws" && git rev-parse --git-path index 2>/dev/null)"; then
      GIT_INDEX_FILE="$stamp.index"
      export GIT_INDEX_FILE
      # 前回の実行で残った index を持ち越さない。消しておけば git が空から作り直す
      rm -f "$GIT_INDEX_FILE"
      # 初回コミット前は index が無い。空のまま進めても tracked がないので実害はない
      (cd "$ws" && cp "$idx" "$GIT_INDEX_FILE" 2>/dev/null) || :
      # gitignore 済みも入れたいので --force。パスの空白で壊れないよう NUL 区切りで渡す
      echo "$files" | head -"$max" | tr '\n' '\0' | (cd "$ws" && xargs -0 git add -N --force -- 2>/dev/null) || :
      # --summary は mode change やシンボリックリンク化を 1 行で見せてくれる
      echo "$files" | head -"$max" | tr '\n' '\0' | (cd "$ws" && xargs -0 git diff --stat --summary --) || :
    else
      # git リポジトリでなければ一覧だけ出す
      echo "$files" | head -"$max"
    fi
    omitted "$files"
  fi
  if [ -n "$ingit" ]; then
    echo "ホストの git が直接読むファイル:"
    echo "$ingit" | head -"$max"
    omitted "$ingit"
  fi
  if [ -n "$gone" ]; then
    echo "削除されたファイル:"
    echo "$gone" | head -"$max"
    omitted "$gone"
  fi
  unset GIT_INDEX_FILE
}

run() {
  ws="$1"; shift
  # bind mount のソースが無いと Docker がディレクトリとして作ってしまうので、先に空ファイルを置く
  [ -e "$HOME/.claude/CLAUDE.md" ] || { mkdir -p "$HOME/.claude"; : > "$HOME/.claude/CLAUDE.md"; }
  # override は任意なので、無ければ空の JSON を置いておく（マウント先がディレクトリになるのを防ぐ）
  [ -e "$repo/settings.override.json" ] || echo '{}' > "$repo/settings.override.json"
  overlay quiet
  # ホスト側の git があとで実行するもの（hooks、config の alias や filter ドライバ）は
  # 書き換えられないように ro で重ねる。core.hooksPath の定義先も config なので一緒に塞がる。
  # .git がファイルの worktree / submodule や、そもそも git 管理外なら対象が無いので何もしない
  set -- claude "$@"
  [ -f "$ws/.git/config" ] && set -- -v "$ws/.git/config:$ws/.git/config:ro" "$@"
  [ -d "$ws/.git/hooks" ] && set -- -v "$ws/.git/hooks:$ws/.git/hooks:ro" "$@"
  # worktree / submodule では .git がファイルで、objects も refs も本体側にある。そこが
  # マウントに入らないと git が一切使えないので、本体の gitdir を足す。ただし ro に限る。
  # rw にすると本体の hooks / config をコンテナから書き換えられて、上のガードと同じ穴が
  # 開く（しかも影響は本体のチェックアウトと他の worktree 全部に及ぶ）。
  # 読めれば log / diff / blame は通り、index を作れないので add / commit は落ちる
  [ -f "$ws/.git" ] \
    && common="$(cd "$ws" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd)" \
    && set -- -v "$common:$common:ro" "$@"
  # 書き換え検出の基準時刻。カーネルの時刻は数ミリ秒単位でしか進まず、同じ刻みの中の
  # 書き込みは -cnewer で拾えないので、基準を 1 秒だけ過去にずらしておく（BSD / GNU 両対応）
  stamp="$(state_stamp "$ws")"
  touch -t "$(date -v-1S '+%Y%m%d%H%M.%S' 2>/dev/null || date -d '1 second ago' '+%Y%m%d%H%M.%S')" "$stamp"
  # 削除の検出用。開始時のファイル一覧を控える（1 走査ぶんのコスト）
  (cd "$ws" && snapshot_files) > "$stamp.before"
  # claude の終了コードを持ち帰りたいので set -e に殺されないようにする
  st=0
  WORKSPACE="$ws" compose run --rm "$@" || st=$?
  report_changes "$ws" "$stamp"
  return $st
}

# 終了時の報告を、あとからもう一度出すためのコマンド（画面を流されても追える）
cmd_diff() {
  stamp="$(state_stamp "$PWD")"
  [ -f "$stamp" ] || { echo "このディレクトリで enclaudé を実行した記録がありません" >&2; return 1; }
  report_changes "$PWD" "$stamp" diff
}

cmd_edit() {
  # 初回は sample から起こす。リポジトリのパスを覚えなくてよくするのがこのコマンドの主目的
  [ -e "$repo/Dockerfile.override" ] || cp "$repo/Dockerfile.override.sample" "$repo/Dockerfile.override"
  ${EDITOR:-vi} "$repo/Dockerfile.override"
  echo "変更したら enclaudé rebuild を実行してください"
}

cmd_rebuild() {
  overlay
  compose build
}

# ロックの packages セクションから claude-code 本体のバージョンを拾う。
# -darwin-arm64 などのサブパッケージは `claude-code@` で終わらないので引っかからない
lock_version() { sed -n "s|^  '@anthropic-ai/claude-code@\(.*\)':\$|\1|p" "$1" | head -1; }

cmd_self_update() {
  # 上がる先は pnpm を走らせるまで分からないので、先にロックだけ更新して差分を見せる。
  # 断られたら戻せるように控えを取っておく（git 管理外の編集中でも壊さないよう cp で）
  for f in package.json pnpm-lock.yaml; do cp "$repo/$f" "$repo/$f.bak"; done
  # ロックは update ではなく捨てて引き直す。pnpm は既存ロックも minimumReleaseAge で検証するので、
  # update だと「今のロックが新しすぎる」だけで止まってしまう。
  # specifier が "latest" なので install だけでポリシー適合の最新に解決される。
  # store-dir はコンテナ内に置く。既定だと /w と同じファイルシステム（= リポジトリ直下）に
  # .pnpm-store が作られ、コンテナが消えてもホスト側に残ってしまう。
  # root で書くとホスト側で root 所有のファイルが残るので、最後に呼び出し元へ返す
  # ホストに pnpm を用意させたくないので、ロックの更新はコンテナの中で行う。
  # Dockerfile と同じ corepack 経由の pnpm を使わないとロックの形式がずれる
  if ! docker run --rm -v "$repo:/w" -w /w node:22-slim sh -c \
    "corepack enable && rm -f pnpm-lock.yaml && pnpm install --lockfile-only --store-dir /tmp/pnpm-store; s=\$?; chown $(id -u):$(id -g) package.json pnpm-lock.yaml 2>/dev/null; exit \$s"
  then
    # set -e に任せて抜けるとロックを消したまま中断してしまうので、ここで必ず戻す
    for f in package.json pnpm-lock.yaml; do mv "$repo/$f.bak" "$repo/$f"; done
    echo "ロックの更新に失敗しました（元に戻しました）" >&2
    return 1
  fi

  if cmp -s "$repo/pnpm-lock.yaml" "$repo/pnpm-lock.yaml.bak"; then
    rm -f "$repo/package.json.bak" "$repo/pnpm-lock.yaml.bak"
    echo "claude-code $(lock_version "$repo/pnpm-lock.yaml") は最新です。再ビルドは不要です"
    return 0
  fi

  printf 'claude-code %s -> %s に更新します。イメージを再ビルドしますか? [Y/n] ' \
    "$(lock_version "$repo/pnpm-lock.yaml.bak")" "$(lock_version "$repo/pnpm-lock.yaml")"
  read -r ans
  case "$ans" in
    ''|y|Y)
      rm -f "$repo/package.json.bak" "$repo/pnpm-lock.yaml.bak"
      ;;
    *)
      # 再ビルドしないならロックを戻す。放置するとロックとイメージが食い違い、
      # 次の起動でも古いイメージがそのまま使われて気付けない
      for f in package.json pnpm-lock.yaml; do mv "$repo/$f.bak" "$repo/$f"; done
      echo "中止しました（ロックは元に戻しました）"
      return 0
      ;;
  esac
  cmd_rebuild
}

cmd_destroy() {
  printf 'コンテナ・イメージ・ボリュームを削除します（コンテナ内のログインと履歴が消えます。ホストの ~/.claude はそのまま）。続行しますか? [y/N] '
  read -r ans
  [ "$ans" = "y" ] || { echo "中止しました"; return 0; }
  compose down --rmi local -v
  # overlay で焼いたベースは compose の管理外なので個別に消す
  docker image rm -f enclaude-base >/dev/null 2>&1 || true
}

cmd_help() {
  cat <<'EOF'
enclaudé — claude-code を Docker のサンドボックスで動かすラッパー

  enclaudé [args...]        カレントディレクトリをマウントして起動。引数はそのまま claude に渡る
  enclaudé diff             直前のセッションでの書き換えを再表示（gitignore 済みも含む）
  enclaudé edit             Dockerfile.override を $EDITOR で編集（初回は sample から作成）
  enclaudé rebuild          イメージを再ビルド（Dockerfile / Dockerfile.override を変えたら実行）
  enclaudé self-update      claude-code を最新に更新して再ビルド（pnpm-lock.yaml を更新）
  enclaudé destroy          コンテナ・イメージ・ボリュームを削除
  enclaudé help             このヘルプ
  enclaudé completion       補完スクリプトを出力（eval "$(enclaudé completion)"）

claude 自身のオプションは enclaudé --help（そのまま claude に渡ります）
EOF
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  _enclaude() { _arguments '1: :(help completion diff edit rebuild self-update destroy)' '*::arg:_files'; }
  compdef _enclaude enclaudé
else
  _enclaude() {
    [ "$COMP_CWORD" -eq 1 ] || return 0
    COMPREPLY=($(compgen -W "help completion diff edit rebuild self-update destroy" -- "${COMP_WORDS[1]}"))
  }
  complete -F _enclaude enclaudé
fi
EOF
}

case "${1:-}" in
  help)         cmd_help ;;
  completion)   cmd_completion ;;
  diff)         cmd_diff ;;
  edit)         cmd_edit ;;
  rebuild)      cmd_rebuild ;;
  self-update)  cmd_self_update ;;
  destroy)      cmd_destroy ;;
  *)            run "$PWD" "$@" ;;
esac
