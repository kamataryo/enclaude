#!/usr/bin/env bash
set -euo pipefail

# シンボリックリンク経由で呼ばれてもリポジトリを見つける
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  src="$(cd "$(dirname "$src")" && pwd)/$(readlink "$src")"
done
repo="$(cd "$(dirname "$src")/.." && pwd)"

compose() { docker-compose -f "$repo/compose.yml" "$@"; }

run() {
  local ws="$1"; shift
  # claude 自身の終了メッセージは `claude --resume <id>` と出る（ネイティブバイナリなので直せない）。
  # session-id をこちらで決めておき、終了後に enclaudé 版の案内を上書きで出す
  local sid=""
  case " $* " in
    *" --resume "*|*" --continue "*|*" -c "*|*" --version "*|*" --help "*|*" -h "*) ;;
    *) sid="$(uuidgen | tr 'A-Z' 'a-z')" ;;
  esac
  local st=0
  WORKSPACE="$ws" compose run --rm claude ${sid:+--session-id "$sid"} "$@" || st=$?
  if [ -n "$sid" ]; then
    echo "Resume this session with: enclaudé --resume $sid"
  fi
  return "$st"
}

cmd_self_update() {
  command -v pnpm >/dev/null || { echo "pnpm が見つかりません" >&2; exit 1; }
  # ホスト側は node_modules を作らない。実体を入れるのはコンテナのビルドだけ
  (cd "$repo" && pnpm update --latest --lockfile-only)
  compose build
  echo
  echo "更新しました。差分: git -C $repo diff pnpm-lock.yaml"
}

cmd_worktree() {
  local name="${1:?usage: enclaudé worktree <name>}"; shift
  local root branch dir base_sha
  root="$(git rev-parse --show-toplevel)"
  branch="wt/enclaude/${name}"
  dir="${root}/../wt_${name}_$(basename "$root")"
  base_sha="$(git rev-parse HEAD)"

  git worktree add -b "$branch" "$dir"
  run "$dir" "$@" || true

  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    echo "未コミットの変更があるので残します: $dir"
    return
  fi

  local head_sha
  head_sha="$(git -C "$dir" rev-parse HEAD)"

  # ponytail: untracked や他プロセスが掴んでいると remove は失敗する。そのときは残す
  git worktree remove "$dir" || { echo "worktree を削除できないので残します: $dir"; return; }

  if [ "$head_sha" = "$base_sha" ]; then
    git branch -d "$branch"
    echo "worktree とブランチ $branch を削除しました"
  else
    echo "worktree を削除しました（ブランチ $branch は残しています）"
  fi
}

cmd_help() {
  cat <<'EOF'
enclaudé — claude-code を Docker のサンドボックスで動かすラッパー

  enclaudé [args...]        カレントディレクトリをマウントして起動。引数はそのまま claude に渡る
  enclaudé worktree <name>  wt/enclaude/<name> の worktree を作って起動。終了時に後片付け
  enclaudé self-update      claude-code を最新にしてイメージを再ビルド
  enclaudé help             このヘルプ
  enclaudé --completion     補完スクリプトを出力（eval "$(enclaudé --completion)"）

claude 自身のオプションは enclaudé --help（そのまま claude に渡ります）
EOF
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  _enclaude() { _arguments '1: :(self-update worktree help --completion)' '*::arg:_files'; }
  compdef _enclaude enclaudé
else
  _enclaude() {
    [ "$COMP_CWORD" -eq 1 ] || return 0
    COMPREPLY=($(compgen -W "self-update worktree help --completion" -- "${COMP_WORDS[1]}"))
  }
  complete -F _enclaude enclaudé
fi
EOF
}

case "${1:-}" in
  self-update)  shift; cmd_self_update "$@" ;;
  worktree)     shift; cmd_worktree "$@" ;;
  help)         cmd_help ;;
  --completion) cmd_completion ;;
  *)            run "$PWD" "$@" ;;
esac
