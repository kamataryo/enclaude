#!/bin/sh
set -eu

# シンボリックリンク経由で呼ばれてもリポジトリを見つける
src="$0"
while [ -L "$src" ]; do
  src="$(cd "$(dirname "$src")" && pwd)/$(readlink "$src")"
done
repo="$(cd "$(dirname "$src")/.." && pwd)"

compose() { docker compose -f "$repo/compose.yml" "$@"; }

# Dockerfile.override があれば、ベースを enclaude-base として焼いてから皮をかぶせる。
# compose 側は dockerfile: ${ENCLAUDE_DOCKERFILE:-Dockerfile} で受ける。
# 起動時（if-missing）はベースが無いときだけ焼く。あっても compose run は皮を作り直さないので無駄になる
overlay() {
  [ -e "$repo/Dockerfile.override" ] || return 0
  export ENCLAUDE_DOCKERFILE=Dockerfile.override
  if [ "${1:-}" = if-missing ] && docker image inspect enclaude-base >/dev/null 2>&1; then return 0; fi
  docker build -t enclaude-base "$repo"
}

# ホストのタイムゾーンをコンテナへ渡す。macOS は TZ を環境変数に持たないことが多いので、
# その場合は /etc/localtime のリンク先から拾う（compose 側は ${TZ:-UTC} で受ける）
host_tz() { [ -n "${TZ:-}" ] && echo "$TZ" || readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p'; }

# worktree / submodule の本体の gitdir を返す。.git ファイルはコンテナの中から書き換えられるので、
# 向き先が本当にこのワークスペースのものか確かめる。確かめないと、無関係なリポジトリの .git を
# 指させるだけで、次の起動でそれがコンテナから読めるようになる。
# 確かめるのはワークスペースの外（中からは書けない）にある、こちらを指し返す記録
git_common_dir() {
  gd="$(cd "$1" && cd "$(git rev-parse --absolute-git-dir 2>/dev/null)" && pwd -P)" || return 1
  common="$(cd "$1" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" && pwd -P)" || return 1
  if [ "$gd" = "$common" ]; then
    # submodule: .git/modules/<name>/config の core.worktree（gitdir からの相対）
    wt="$(git --git-dir="$gd" config --get core.worktree)" || return 1
    back="$(cd "$gd" && cd "$wt" && pwd -P)" || return 1
  else
    # worktree: 本体の worktrees/<name>/gitdir（相対なら gitdir 基準）。worktrees/ の下であることも
    # 見ないと、中に偽の gitdir を作って commondir で別のリポジトリへ飛ばせる
    case "$gd" in "$common"/worktrees/*) ;; *) return 1 ;; esac
    back="$(cd "$gd" && cd "$(dirname "$(cat gitdir)")" && pwd -P)" || return 1
  fi
  [ "$back" = "$1" ] && echo "$common"
}

# origin が GitHub なら owner/repo を返す。.git は ro で渡すので、コンテナの中から origin を
# 書き換えて別のリポジトリのトークンを引き出すことはできない
gh_repo() {
  git -C "$1" remote get-url origin 2>/dev/null \
    | sed -n 's#^.*github\.com[:/]\([A-Za-z0-9-]*/[A-Za-z0-9_.-]*\)$#\1#p' | sed 's/\.git$//'
}

# リポジトリごとの GitHub トークン（enclaudé gh-token で作る）。ホスト側に置き、マウントはしない
token_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/enclaude/gh-tokens/$1"; }

run() {
  # シンボリックリンクを解いておく。Docker はリンクをたどってマウントするので、論理パスのまま
  # 比べると ~/work/h -> ~ のようなリンク経由で $HOME の判定を素通りする
  ws="$(pwd -P)"
  # マウントした時点でホスト側に手が届いてしまうディレクトリは、その前に弾く。
  # $HOME 以上を丸ごと渡すと ~/.ssh や ~/.aws が rw で入る。/Users のような親も同じ
  case "$ws" in /)
    echo "/ をそのままマウントするのは危険です" >&2; exit 1 ;;
  esac
  home="$(cd "$HOME" 2>/dev/null && pwd -P)" || home="$HOME"
  case "$home" in "$ws"|"$ws"/*)
    echo "\$HOME を含むディレクトリでは起動できません: $ws" >&2; exit 1 ;;
  esac
  # -v の区切りと衝突する
  case "$ws" in *:*)
    echo ": を含むパスはマウントできません: $ws" >&2; exit 1 ;;
  esac
  # bind mount のソースが無いと Docker がディレクトリとして作ってしまうので、先に空ファイルを置く
  [ -e "$HOME/.claude/CLAUDE.md" ] || { mkdir -p "$HOME/.claude"; : > "$HOME/.claude/CLAUDE.md"; }
  # override は任意なので、無ければ空の JSON を置いておく（マウント先がディレクトリになるのを防ぐ）
  [ -e "$repo/settings.override.json" ] || echo '{}' > "$repo/settings.override.json"
  overlay if-missing
  set -- claude "$@"
  # ホストの git があとで実行するもの（hooks、config の alias や fsmonitor）を書き換えられないよう、
  # .git は丸ごと ro で重ねる。config と hooks だけでは足りない。.git/commondir を置かれると git は
  # config も hooks もその先から読むし、worktree の .git ファイルは向き先そのものを差し替えられる
  [ -e "$ws/.git" ] && set -- -v "$ws/.git:$ws/.git:ro" "$@"
  # ホスト側で core.hooksPath が設定済み（husky など）なら、その参照先はワークスペース内の
  # 普通のディレクトリでしかない。ホストで git commit したときに走るのは同じなので、そこも ro で重ねる。
  # 相対パスの基準は worktree のルート（git はフックの実行前にそこへ cd する）
  hp="$(cd "$ws" && git config --get core.hooksPath 2>/dev/null)" || hp=""
  if [ -n "$hp" ]; then
    case "$hp" in /*) ;; *) hp="$ws/$hp" ;; esac
    # husky v9 の hooksPath は .husky/_ で、その中のラッパーが親の .husky/<hook> を実行する。
    # 参照先だけ ro にしても書き換え放題なので、_ なら親ごと重ねる
    case "$hp" in */_) hp="${hp%/_}" ;; esac
    # ワークスペースの外（~/.config/git/hooks など）はそもそもマウントしないので対象外。
    # $ws 自身に縮んだ場合もここで落ちる（ワークスペース全体を ro にはできない）
    case "$hp" in "$ws"/*) if [ -d "$hp" ]; then set -- -v "$hp:$hp:ro" "$@"; fi ;; esac
  fi
  # worktree / submodule では objects も refs も本体側にあり、足さないと git が一切使えない。
  # rw にすると本体の hooks / config を書き換えられるので ro に限る（log / diff は通る）
  if [ -f "$ws/.git" ]; then
    if common="$(git_common_dir "$ws")"; then
      set -- -v "$common:$common:ro" "$@"
    else
      echo "enclaudé: .git の向き先がこのディレクトリのものと確認できないので、本体の gitdir はマウントしません" >&2
    fi
  fi
  # このリポジトリ用のトークンがあるときだけ渡す。値は引数に出さず環境変数で渡す（ps から見えない）
  r="$(gh_repo "$ws")"
  if [ -n "$r" ] && [ -f "$(token_file "$r")" ]; then
    GH_TOKEN="$(cat "$(token_file "$r")")"
    export GH_TOKEN
    set -- -e GH_TOKEN "$@"
  fi
  # claude の終了コードを持ち帰りたいので set -e に殺されないようにする
  st=0
  WORKSPACE="$ws" TZ="$(host_tz)" compose run --rm "$@" || st=$?
  return $st
}

cmd_edit() {
  # 初回は sample から起こす。リポジトリのパスを覚えなくてよくするのがこのコマンドの主目的
  [ -e "$repo/Dockerfile.override" ] || cp "$repo/Dockerfile.override.sample" "$repo/Dockerfile.override"
  ${EDITOR:-vi} "$repo/Dockerfile.override"
  echo "変更したら enclaudé rebuild を実行してください"
}

cmd_gh_token() {
  r="$(gh_repo "$(pwd -P)")"
  [ -n "$r" ] || { echo "origin が GitHub のリポジトリではありません" >&2; return 1; }
  # 権限・owner・期限はテンプレート URL で埋められるが、リポジトリの選択だけは埋められない
  name="$(printf 'enclaude-%s' "$(echo "$r" | tr / -)" | cut -c1-40)"
  url="https://github.com/settings/personal-access-tokens/new?name=$name&description=Select+only+$r&target_name=${r%%/*}&expires_in=90&issues=write"
  echo "$r 用のトークンを作ります。Repository access で「Only select repositories」→ $r だけを選んで作成してください"
  echo "$url"
  if [ "$(uname)" = Darwin ]; then open "$url"; elif command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1 || :; fi
  printf 'トークンを貼り付けてください（表示されません）: '
  trap 'stty echo 2>/dev/null' EXIT
  trap 'exit 130' INT TERM
  stty -echo 2>/dev/null || :
  read -r t
  stty echo 2>/dev/null || :
  echo
  [ -n "$t" ] || { echo "中止しました" >&2; return 1; }
  # 無効なトークンや、private リポジトリを選び忘れたトークンはここで弾く（public だと選び忘れは見抜けない）
  if ! curl -fsS -o /dev/null -H "Authorization: Bearer $t" "https://api.github.com/repos/$r"; then
    echo "このトークンでは $r にアクセスできません（保存しません）" >&2
    return 1
  fi
  f="$(token_file "$r")"
  mkdir -p "$(dirname "$f")"
  (umask 077 && printf '%s\n' "$t" > "$f")
  echo "保存しました: $f"
}

cmd_rebuild() {
  overlay
  compose build
}

# ロックの packages セクションから claude-code 本体のバージョンを拾う。
# -darwin-arm64 などのサブパッケージは `claude-code@` で終わらないので引っかからない
lock_version() { sed -n "s|^  '@anthropic-ai/claude-code@\(.*\)':\$|\1|p" "$1" | head -1; }

cmd_self_update() {
  # 上がる先は pnpm を走らせるまで分からないので、先にロックだけ更新して差分を見せる。
  # 控えは git 管理外の編集中でも壊さないよう cp で取り、途中で抜けたら（失敗・中止・Ctrl-C・EOF）
  # trap で必ず戻す。ロックとイメージが食い違ったまま残ると、古いイメージが使われ続けて気付けない
  for f in package.json pnpm-lock.yaml; do cp "$repo/$f" "$repo/$f.bak"; done
  trap 'for f in package.json pnpm-lock.yaml; do if [ -e "$repo/$f.bak" ]; then mv "$repo/$f.bak" "$repo/$f"; fi; done' EXIT
  trap 'exit 130' INT TERM
  # ホストに pnpm を用意させたくないのでコンテナの中で更新する。Dockerfile と同じ corepack 経由の
  # pnpm でないとロックの形式がずれるので、イメージは FROM 行から取る（ダイジェスト付きのまま）
  base_image="$(sed -n 's/^FROM \([^ ]*\).*/\1/p' "$repo/Dockerfile" | head -n1)"
  # - ロックは update せず捨てて引き直す。pnpm は既存ロックも minimumReleaseAge で検証するので、
  #   update だと「今のロックが新しすぎる」だけで止まる。specifier が latest なので install で足りる
  # - store は既定だとリポジトリ直下の .pnpm-store になってホストに残るので、コンテナ内に置く
  # - root で書いたファイルはホストで root 所有になるので、呼び出し元に返す
  if ! docker run --rm -v "$repo:/w" -w /w "$base_image" sh -c \
    "corepack enable && rm -f pnpm-lock.yaml && pnpm install --lockfile-only --store-dir /tmp/pnpm-store; s=\$?; chown $(id -u):$(id -g) package.json pnpm-lock.yaml 2>/dev/null; exit \$s"
  then
    echo "ロックの更新に失敗しました（元に戻します）" >&2
    return 1
  fi

  if cmp -s "$repo/pnpm-lock.yaml" "$repo/pnpm-lock.yaml.bak"; then
    echo "claude-code $(lock_version "$repo/pnpm-lock.yaml") は最新です。再ビルドは不要です"
    return 0
  fi

  printf 'claude-code %s -> %s に更新します。イメージを再ビルドしますか? [Y/n] ' \
    "$(lock_version "$repo/pnpm-lock.yaml.bak")" "$(lock_version "$repo/pnpm-lock.yaml")"
  read -r ans
  case "$ans" in
    ''|y|Y) rm -f "$repo/package.json.bak" "$repo/pnpm-lock.yaml.bak" ;;
    *) echo "中止しました（ロックは元に戻します）"; return 0 ;;
  esac
  cmd_rebuild
}

cmd_destroy() {
  printf 'コンテナ・イメージ・ボリュームを削除します（コンテナ内のログインと履歴が消えます。ホストの ~/.claude はそのまま）。続行しますか? [y/N] '
  read -r ans
  [ "$ans" = "y" ] || { echo "中止しました"; return 0; }
  compose down --rmi local -v
  # overlay で焼いたベースは compose の管理外なので個別に消す
  docker image rm -f enclaude-base >/dev/null 2>&1 || true
}

cmd_help() {
  cat <<'EOF'
enclaudé — claude-code を Docker のサンドボックスで動かすラッパー

  enclaudé [args...]        カレントディレクトリをマウントして起動。引数はそのまま claude に渡る
  enclaudé resume [id]      claude --resume と同じ
  enclaudé edit             Dockerfile.override を $EDITOR で編集（初回は sample から作成）
  enclaudé rebuild          イメージを再ビルド（Dockerfile / Dockerfile.override を変えたら実行）
  enclaudé self-update      claude-code を最新に更新して再ビルド（pnpm-lock.yaml を更新）
  enclaudé destroy          コンテナ・イメージ・ボリュームを削除
  enclaudé gh-token         このリポジトリの Issue を読み書きするトークンを登録
  enclaudé help             このヘルプ
  enclaudé completion       補完スクリプトを出力（eval "$(enclaudé completion)"）

claude 自身のオプションは enclaudé --help（そのまま claude に渡ります）
EOF
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  _enclaude() { _arguments '1: :(help completion resume edit rebuild self-update destroy gh-token)' '*::arg:_files'; }
  compdef _enclaude enclaudé
else
  _enclaude() {
    [ "$COMP_CWORD" -eq 1 ] || return 0
    COMPREPLY=($(compgen -W "help completion resume edit rebuild self-update destroy gh-token" -- "${COMP_WORDS[1]}"))
  }
  complete -F _enclaude enclaudé
fi
EOF
}

case "${1:-}" in
  help)         cmd_help ;;
  completion)   cmd_completion ;;
  resume)       shift; run --resume "$@" ;;
  edit)         cmd_edit ;;
  rebuild)      cmd_rebuild ;;
  self-update)  cmd_self_update ;;
  destroy)      cmd_destroy ;;
  gh-token)     cmd_gh_token ;;
  *)            run "$@" ;;
esac
