#!/bin/sh
set -eu

# シンボリックリンク経由で呼ばれてもリポジトリを見つける
src="$0"
while [ -L "$src" ]; do
  src="$(cd "$(dirname "$src")" && pwd)/$(readlink "$src")"
done
repo="$(cd "$(dirname "$src")/.." && pwd)"

compose() { docker compose -f "$repo/compose.yml" "$@"; }

# Dockerfile.override があれば、ベースを enclaude-base として焼いてから皮をかぶせる。
# compose 側は dockerfile: ${ENCLAUDE_DOCKERFILE:-Dockerfile} で受ける
overlay() {
  [ -e "$repo/Dockerfile.override" ] || return 0
  if [ "${1:-}" = quiet ]; then
    docker build -q -t enclaude-base "$repo" >/dev/null
  else
    docker build -t enclaude-base "$repo"
  fi
  export ENCLAUDE_DOCKERFILE=Dockerfile.override
}

run() {
  ws="$1"; shift
  # bind mount のソースが無いと Docker がディレクトリとして作ってしまうので、先に空ファイルを置く
  [ -e "$HOME/.claude/CLAUDE.md" ] || { mkdir -p "$HOME/.claude"; : > "$HOME/.claude/CLAUDE.md"; }
  # override は任意なので、無ければ空の JSON を置いておく（マウント先がディレクトリになるのを防ぐ）
  [ -e "$repo/settings.override.json" ] || echo '{}' > "$repo/settings.override.json"
  overlay quiet
  WORKSPACE="$ws" compose run --rm claude "$@"
}

cmd_edit() {
  # 初回は sample から起こす。リポジトリのパスを覚えなくてよくするのがこのコマンドの主目的
  [ -e "$repo/Dockerfile.override" ] || cp "$repo/Dockerfile.override.sample" "$repo/Dockerfile.override"
  ${EDITOR:-vi} "$repo/Dockerfile.override"
  echo "変更したら enclaudé rebuild を実行してください"
}

cmd_rebuild() {
  overlay
  compose build
}

# ロックの packages セクションから claude-code 本体のバージョンを拾う。
# -darwin-arm64 などのサブパッケージは `claude-code@` で終わらないので引っかからない
lock_version() { sed -n "s|^  '@anthropic-ai/claude-code@\(.*\)':\$|\1|p" "$1" | head -1; }

cmd_self_update() {
  # 上がる先は pnpm を走らせるまで分からないので、先にロックだけ更新して差分を見せる。
  # 断られたら戻せるように控えを取っておく（git 管理外の編集中でも壊さないよう cp で）
  for f in package.json pnpm-lock.yaml; do cp "$repo/$f" "$repo/$f.bak"; done
  # ホストに pnpm を用意させたくないので、ロックの更新はコンテナの中で行う。
  # Dockerfile と同じ corepack 経由の pnpm を使わないとロックの形式がずれる。
  # store-dir はコンテナ内に置く。既定だと /w と同じファイルシステム（= リポジトリ直下）に
  # .pnpm-store が作られ、コンテナが消えてもホスト側に残ってしまう。
  # root で書くとホスト側で root 所有のファイルが残るので、最後に呼び出し元へ返す
  docker run --rm -v "$repo:/w" -w /w node:22-slim sh -c \
    "corepack enable && pnpm update --latest --lockfile-only --store-dir /tmp/pnpm-store; s=\$?; chown $(id -u):$(id -g) package.json pnpm-lock.yaml 2>/dev/null; exit \$s"

  if cmp -s "$repo/pnpm-lock.yaml" "$repo/pnpm-lock.yaml.bak"; then
    rm -f "$repo/package.json.bak" "$repo/pnpm-lock.yaml.bak"
    echo "claude-code $(lock_version "$repo/pnpm-lock.yaml") は最新です。再ビルドは不要です"
    return 0
  fi

  printf 'claude-code %s -> %s に更新します。イメージを再ビルドしますか? [Y/n] ' \
    "$(lock_version "$repo/pnpm-lock.yaml.bak")" "$(lock_version "$repo/pnpm-lock.yaml")"
  read -r ans
  case "$ans" in
    ''|y|Y)
      rm -f "$repo/package.json.bak" "$repo/pnpm-lock.yaml.bak"
      ;;
    *)
      # 再ビルドしないならロックを戻す。放置するとロックとイメージが食い違い、
      # 次の起動でも古いイメージがそのまま使われて気付けない
      for f in package.json pnpm-lock.yaml; do mv "$repo/$f.bak" "$repo/$f"; done
      echo "中止しました（ロックは元に戻しました）"
      return 0
      ;;
  esac
  cmd_rebuild
}

cmd_destroy() {
  printf 'コンテナ・イメージ・ボリュームを削除します（コンテナ内のログインと履歴が消えます。ホストの ~/.claude はそのまま）。続行しますか? [y/N] '
  read -r ans
  [ "$ans" = "y" ] || { echo "中止しました"; return 0; }
  compose down --rmi local -v
  # overlay で焼いたベースは compose の管理外なので個別に消す
  docker image rm -f enclaude-base >/dev/null 2>&1 || true
}

cmd_help() {
  cat <<'EOF'
enclaudé — claude-code を Docker のサンドボックスで動かすラッパー

  enclaudé [args...]        カレントディレクトリをマウントして起動。引数はそのまま claude に渡る
  enclaudé edit             Dockerfile.override を $EDITOR で編集（初回は sample から作成）
  enclaudé rebuild          イメージを再ビルド（Dockerfile / Dockerfile.override を変えたら実行）
  enclaudé self-update      claude-code を最新に更新して再ビルド（pnpm-lock.yaml を更新）
  enclaudé destroy          コンテナ・イメージ・ボリュームを削除
  enclaudé help             このヘルプ
  enclaudé completion       補完スクリプトを出力（eval "$(enclaudé completion)"）

claude 自身のオプションは enclaudé --help（そのまま claude に渡ります）
EOF
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  _enclaude() { _arguments '1: :(help completion edit rebuild self-update destroy)' '*::arg:_files'; }
  compdef _enclaude enclaudé
else
  _enclaude() {
    [ "$COMP_CWORD" -eq 1 ] || return 0
    COMPREPLY=($(compgen -W "help completion edit rebuild self-update destroy" -- "${COMP_WORDS[1]}"))
  }
  complete -F _enclaude enclaudé
fi
EOF
}

case "${1:-}" in
  help)         cmd_help ;;
  completion)   cmd_completion ;;
  edit)         cmd_edit ;;
  rebuild)      cmd_rebuild ;;
  self-update)  cmd_self_update ;;
  destroy)      cmd_destroy ;;
  *)            run "$PWD" "$@" ;;
esac
