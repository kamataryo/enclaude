#!/usr/bin/env bash
set -euo pipefail

# シンボリックリンク経由で呼ばれてもリポジトリを見つける
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  src="$(cd "$(dirname "$src")" && pwd)/$(readlink "$src")"
done
repo="$(cd "$(dirname "$src")/.." && pwd)"

compose() { docker-compose -f "$repo/compose.yml" "$@"; }

run() {
  local ws="$1"; shift
  # bind mount のソースが無いと Docker がディレクトリとして作ってしまうので、先に空ファイルを置く
  [ -e "$HOME/.claude/CLAUDE.md" ] || { mkdir -p "$HOME/.claude"; : > "$HOME/.claude/CLAUDE.md"; }
  # claude 自身の終了メッセージは `claude --resume <id>` と出る（ネイティブバイナリなので直せない）。
  # session-id をこちらで決めておき、終了後に enclaudé 版の案内を上書きで出す
  local sid=""
  case " $* " in
    *" --resume "*|*" --continue "*|*" -c "*|*" --version "*|*" --help "*|*" -h "*) ;;
    *) sid="$(uuidgen | tr 'A-Z' 'a-z')" ;;
  esac
  local st=0
  WORKSPACE="$ws" compose run --rm claude ${sid:+--session-id "$sid"} "$@" || st=$?
  if [ -n "$sid" ]; then
    echo "Resume this session with: enclaudé --resume $sid"
  fi
  return "$st"
}

cmd_self_update() {
  command -v pnpm >/dev/null || { echo "pnpm が見つかりません" >&2; exit 1; }
  # ホスト側は node_modules を作らない。実体を入れるのはコンテナのビルドだけ
  (cd "$repo" && pnpm update --latest --lockfile-only)
  compose build
  echo
  echo "更新しました。差分: git -C $repo diff pnpm-lock.yaml"
}

cmd_help() {
  cat <<'EOF'
enclaudé — claude-code を Docker のサンドボックスで動かすラッパー

  enclaudé [args...]        カレントディレクトリをマウントして起動。引数はそのまま claude に渡る
  enclaudé self-update      claude-code を最新にしてイメージを再ビルド
  enclaudé help             このヘルプ
  enclaudé completion       補完スクリプトを出力（eval "$(enclaudé completion)"）

claude 自身のオプションは enclaudé --help（そのまま claude に渡ります）
EOF
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  _enclaude() { _arguments '1: :(self-update help completion)' '*::arg:_files'; }
  compdef _enclaude enclaudé
else
  _enclaude() {
    [ "$COMP_CWORD" -eq 1 ] || return 0
    COMPREPLY=($(compgen -W "self-update help completion" -- "${COMP_WORDS[1]}"))
  }
  complete -F _enclaude enclaudé
fi
EOF
}

case "${1:-}" in
  self-update)  shift; cmd_self_update "$@" ;;
  help)         cmd_help ;;
  completion)   cmd_completion ;;
  *)            run "$PWD" "$@" ;;
esac
